  {
   "id": "regina-caeli",
   "title": "Regina Caeli",
   "source_url": "https://www.usccb.org/prayers/regina-caeli",
   "copied": "2026-10-24",
   "paragraphs": [
    [
     [
      {
       "t": "Queen of heaven, rejoice, alleluia."
      }
     ],
     [
      {
       "t": "The Son whom you merited to bear, alleluia,"
      }
     ],
     [
      {
       "t": "has risen as he said, alleluia."
      }
     ],
     [
      {
       "t": "Pray for us to God, alleluia."
      }
     ]
    ],
    [
     [
      {
       "t": "V.",
       "b": true
      },
      {
       "t": " Rejoice and be glad, O Virgin Mary, alleluia."
      }
     ],
     [
      {
       "t": "R.",
       "b": true
      },
      {
       "t": " For the Lord has truly risen, alleluia."
      }
     ]
    ],
    [
     [
      {
       "t": "Let us pray."
      }
     ]
    ],
    [
     [
      {
       "t": "O God, who have been pleased to gladden the world"
      }
     ],
     [
      {
       "t": "by the Resurrection of your Son our Lord Jesus Christ,"
      }
     ],
     [
      {
       "t": "grant, we pray,"
      }
     ],
     [
      {
       "t": "that through his Mother, the Virgin Mary,"
      }
     ],
     [
      {
       "t": "we may receive the joys of everlasting life."
      }
     ],
     [
      {
       "t": "Through Christ our Lord. Amen."
      }
     ]
    ]
   ]
  }
 ]
}